      "Bash(gh pr review * --request-changes:*)",
      "Bash(gh api:*)",
      "Bash(gh workflow:*)",
      "Bash(git tag:*)",
      "Bash(sudo:*)",
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker volume:*)",
      "Bash(docker system:*)",
      "Read(//home/dev/.config/agent-runner/**)",
      "Read(//home/dev/.config/strelitzia-agent/**)",
      "Read(**/.env)",
      "Bash(crontab:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Read(services/nginx/.htpasswd*)",
