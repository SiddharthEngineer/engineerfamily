      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr review * --comment:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(docker compose --env-file .env.template -f docker-compose.base.yml -f docker-compose.local.yml config -q)",
      "Bash(docker compose --env-file .env.template -f docker-compose.base.yml -f docker-compose.preprod.yml config -q)",
      "Bash(docker compose --env-file .env.template -f docker-compose.base.yml -f docker-compose.prod.yml config -q)",
