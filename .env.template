# ─────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in values
# NEVER commit .env to git (it's in .gitignore)
# Store production values as GitHub Actions Secrets
# ─────────────────────────────────────────────────────────

# ─── Umami Analytics ──────────────────────────────────────
# Umami and Streamlit are off by default (compose profiles). Uncomment to run them in this stack.
# COMPOSE_PROFILES=umami,streamlit
UMAMI_HOST=https://umami.engineerfamily.net
UMAMI_APP_ID=
UMAMI_STREAMLIT_ID=
# Generate with: openssl rand -base64 32
UMAMI_DB_PASSWORD=
UMAMI_DB_PASSWORD_PREPROD=
UMAMI_DB_PASSWORD_LOCAL=
UMAMI_APP_SECRET=
UMAMI_APP_SECRET_PREPROD=
UMAMI_APP_SECRET_LOCAL=

# Set these manually after first login to Umami Analytics
UMAMI_USER=admin
UMAMI_PASSWORD=
UMAMI_PASSWORD_PREPROD=
UMAMI_PASSWORD_LOCAL=umami

# ─── Strelitzia (role strelitzia in postgres-db; make strelitzia-db-init) ───
# Generate with: openssl rand -hex 24  (hex avoids URL escaping)
STRELITZIA_DB_PASSWORD=
# Preprod's disposable strelitzia_preprod DB (make preprod-strelitzia-db-init)
STRELITZIA_DB_PASSWORD_PREPROD=

# ─── Site sign-in (Flask /auth/*; off while GOOGLE_CLIENT_ID is empty) ───
# The "Strelitzia web" OAuth client (same Google project as the dashboard). Redirect URI: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the ef_session cookie; its own value per env. Rotating it signs everyone out. openssl rand -hex 32
SITE_SESSION_SECRET=

# ─── Site permissions (engineerfamily DB in postgres-db; make site-db-init / preprod-site-db-init) ───
# Unset password: env-only mode (nothing can be changed on the Users page). Generate with: openssl rand -hex 24
SITE_DB_PASSWORD=
# Preprod's engineerfamily_preprod DB (make preprod-site-db-init)
SITE_DB_PASSWORD_PREPROD=
# Comma lists. They seed an empty DB once (after that the Users page decides); admins also apply in env-only mode.
# Real addresses go in the /srv .env files only, never here.
SITE_ADMIN_EMAILS=
SITE_MEMBER_EMAILS=

# ─── Local Hosts ────────────────────────────────────
APP_LOCAL=engineerfamily.test
STREAMLIT_LOCAL=streamlit.engineerfamily.test
UMAMI_LOCAL=umami.engineerfamily.test

# ─── GitHub Personal Access Token ─────────────────────────
PAT=

# ─── SSH Credentials ─────────────────────────────────────
# Remember to use the SSH passphrase in passwords manager when connecting
ROOT_PASSWORD=
DEPLOY_PASSWORD=